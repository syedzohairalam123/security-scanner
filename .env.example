# Copy this file to .env for local development (python-dotenv loads it
# automatically). In Vercel, set the same names under Project Settings ->
# Environment Variables instead - never commit a real .env file.

# Required
SECRET_KEY=change-me-to-a-long-random-string

# Database. Defaults to a local SQLite file if unset. On Vercel the
# filesystem is ephemeral, so set this to a hosted Postgres URL (Vercel
# Postgres, Neon, and Supabase all work) for scan history to persist.
DATABASE_URL=sqlite:///dev.db

# Optional: AI assistant on the dashboard ("Ask about this report").
# Get a key at https://console.anthropic.com - leave unset to disable
# the feature entirely (the rest of the app works fine without it).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: protects /api/cron/scheduled-scans so only Vercel's scheduler
# (or someone who knows the secret) can trigger a scan batch. Vercel sends
# this automatically as a Bearer token once set as an environment variable.
CRON_SECRET=

# Optional: email notifications for scheduled scans. Any standard SMTP
# provider works (e.g. an app password from Gmail, or Mailgun/SES/Resend's
# SMTP endpoints).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=scanner@example.com

# Optional: raises the NVD CVE-lookup rate limit. Works fine without one at
# low request volume. Get a free key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
